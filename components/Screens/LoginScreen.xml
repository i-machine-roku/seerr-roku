<?xml version="1.0" encoding="utf-8" ?>
<component name="LoginScreen" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/Screens/LoginScreen.brs" />
    <interface>
        <field id="loginSuccess" type="boolean" value="false" />
        <function name="screenShown" />
    </interface>

    <children>
        <Rectangle id="background" width="1920" height="1080" color="0x111827FF" />

        <Poster uri="pkg:/images/logo.png"
                translation="[760, 90]"
                width="400"
                height="150"
                loadDisplayMode="scaleToFit" />

        <Rectangle id="loginCard" width="760" height="640" translation="[580, 260]" color="0x1F2937E6" />

        <!-- "Login with Jellyfin", not "Login with Seerr" — this app only implements the
             Jellyfin-auth flow (Seerr's JellyfinLogin.tsx), a different screen from Seerr's
             own local-account login (which the web UI calls "Login with Seerr"). -->
        <Label text="Login with Jellyfin"
               width="640"
               translation="[640, 300]"
               horizAlign="center"
               font="font:LargeBoldSystemFont"
               color="0xE5E7EBFF" />

        <Label id="statusLabel"
               width="640"
               translation="[640, 350]"
               horizAlign="center"
               font="font:SmallSystemFont"
               color="0xEF4444FF"
               wrap="true" />

        <!-- Button + KeyboardDialog, not TextEditBox/CheckList: the latter looked more like
             jellyfin-roku's own SigninScene, but Button+KeyboardDialog is the one pattern in
             this codebase with an actual track record on real hardware (see CODING_NOTES.md's
             focus-timing history). Not worth trading that for closer visual parity. -->
        <Button id="serverUrlBtn" text="Server URL: https://" translation="[710, 410]" minWidth="500" />
        <Button id="usernameBtn" text="Enter Username" translation="[710, 480]" minWidth="500" />
        <Button id="passwordBtn" text="Enter Password" translation="[710, 550]" minWidth="500" />

        <!-- Registry is the only cross-screen session store this app has (every screen re-reads
             SeerrAuth.serverUrl/connectSid per API call — see CODING_NOTES.md), so this can't
             gate whether we write to it at login; it gates whether the session survives past
             this run. See LoginScreen.brs::onAuthResponse and source/main.brs. -->
        <Button id="saveCredentialsBtn"
                text="Save credentials on this device: ON"
                translation="[710, 620]"
                minWidth="500" />

        <Button id="loginButton" text="Login" translation="[810, 700]" minWidth="300" />

        <ApiTask id="authTask" />
    </children>
</component>
