<?xml version="1.0" encoding="utf-8" ?>
<component name="LoginScreen" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/Screens/LoginScreen.brs" />
    <interface>
        <field id="loginSuccess" type="boolean" value="false" />
    </interface>
    
    <children>
        <!-- Full-bleed dark backdrop: Tailwind gray-900 (#111827), Seerr web login's own bg-gray-900 -->
        <Rectangle id="background" width="1920" height="1080" color="0x111827FF" />

        <!-- Large centered brand lockup, above the card, mirroring the web login -->
        <Poster uri="pkg:/images/logo.png"
                translation="[760, 120]"
                width="400"
                height="150"
                loadDisplayMode="scaleToFit" />

        <!-- Translucent glass card: Tailwind gray-800 at 50% opacity (bg-gray-800/50 +
             backdrop-blur-5px on the web login) -->
        <Rectangle id="loginCard"
                   width="720"
                   height="560"
                   translation="[600, 300]"
                   color="0x1F293780" />

        <!-- "Login with Jellyfin", not "Login with Seerr" — this app only implements the
             Jellyfin-auth flow (seerr's JellyfinLogin.tsx), which is a different screen from
             seerr's own local-account login (which the web UI would call "Login with Seerr") -->
        <Group translation="[660, 340]">
            <Label text="Login with Jellyfin"
                   width="600"
                   horizAlign="center"
                   font="font:LargeBoldSystemFont"
                   color="0xE5E7EBFF" />

            <Label id="statusLabel"
                   translation="[0, 50]"
                   width="600"
                   horizAlign="center"
                   font="font:SmallSystemFont"
                   color="0xEF4444FF" />

            <Group id="inputGroup" translation="[0, 100]">
                <!-- Custom nice buttons -->
                <Button id="serverUrlBtn"
                        text="Server URL: https://"
                        translation="[100, 0]"
                        minWidth="400" />

                <Button id="usernameBtn"
                        text="Enter Username"
                        translation="[100, 70]"
                        minWidth="400" />

                <Button id="passwordBtn"
                        text="Enter Password"
                        translation="[100, 140]"
                        minWidth="400" />

                <Button id="loginButton"
                        text="Login"
                        translation="[100, 230]"
                        minWidth="400"
                        iconUri=""
                        focusedIconUri="" />
            </Group>
        </Group>

        <ApiTask id="authTask" />
    </children>
</component>
