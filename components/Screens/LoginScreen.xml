<?xml version="1.0" encoding="utf-8" ?>
<component name="LoginScreen" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/Screens/LoginScreen.brs" />
    <interface>
        <field id="loginSuccess" type="boolean" value="false" />
        <function name="screenShown" />
    </interface>

    <children>
        <Rectangle id="background" width="1920" height="1080" color="0x111827FF" />

        <Poster uri="pkg:/images/logo.png"
                translation="[760, 90]"
                width="400"
                height="150"
                loadDisplayMode="scaleToFit" />

        <Rectangle id="loginCard" width="760" height="640" translation="[580, 260]" color="0x1F2937E6" />

        <!-- "Login with Jellyfin", not "Login with Seerr" — this app only implements the
             Jellyfin-auth flow (Seerr's JellyfinLogin.tsx), a different screen from Seerr's
             own local-account login (which the web UI calls "Login with Seerr"). -->
        <Label text="Login with Jellyfin"
               width="640"
               translation="[640, 300]"
               horizAlign="center"
               font="font:LargeBoldSystemFont"
               color="0xE5E7EBFF" />

        <Label id="statusLabel"
               width="640"
               translation="[640, 350]"
               horizAlign="center"
               font="font:SmallSystemFont"
               color="0xEF4444FF"
               wrap="true" />

        <!-- Button + KeyboardDialog, not TextEditBox/CheckList: the latter looked more like
             jellyfin-roku's own SigninScene, but Button+KeyboardDialog is the one pattern in
             this codebase with confirmed real-hardware behavior (TextEditBox renders and
             focuses fine but never entered edit mode on OK/Select on a real device — see
             CODING_NOTES.md).

             Every Button here fixes three things a real-device pass surfaced:
             - showFocusFootprint="true": Roku's default Button draws no background at all
               when unfocused, so without it these read as floating bulleted text.
             - iconUri="" focusedIconUri="": Button auto-applies a default generic icon
               (that's what the stray bullet actually was) unless explicitly blanked.
             - matching minWidth/maxWidth: without maxWidth a Button grows to fit its own
               text, so longer content (e.g. a typed server URL) made that one button wider
               than the rest -- fixed width truncates long text instead, which is fine since
               the KeyboardDialog shows the untruncated value while editing.
             Height is fixed at 60 (this app renders at FHD scale, where Button's own default
             height is 96 -- 26px taller than the 70px vertical gap between these buttons,
             which is why they visually overlapped once a background made that gap visible). -->
        <Button id="serverUrlBtn"
                text="Server URL: https://"
                translation="[710, 410]"
                minWidth="600"
                maxWidth="600"
                height="60"
                iconUri=""
                focusedIconUri=""
                showFocusFootprint="true" />
        <Button id="usernameBtn"
                text="Enter Username"
                translation="[710, 480]"
                minWidth="600"
                maxWidth="600"
                height="60"
                iconUri=""
                focusedIconUri=""
                showFocusFootprint="true" />
        <Button id="passwordBtn"
                text="Enter Password"
                translation="[710, 550]"
                minWidth="600"
                maxWidth="600"
                height="60"
                iconUri=""
                focusedIconUri=""
                showFocusFootprint="true" />

        <!-- Registry is the only cross-screen session store this app has (every screen re-reads
             SeerrAuth.serverUrl/connectSid per API call — see CODING_NOTES.md), so this can't
             gate whether we write to it at login; it gates whether the session survives past
             this run. See LoginScreen.brs::onAuthResponse and source/main.brs. -->
        <Button id="saveCredentialsBtn"
                text="Save credentials on this device: ON"
                translation="[710, 620]"
                minWidth="600"
                maxWidth="600"
                height="60"
                iconUri=""
                focusedIconUri=""
                showFocusFootprint="true" />

        <Button id="loginButton"
                text="Login"
                translation="[810, 700]"
                minWidth="300"
                maxWidth="300"
                height="60"
                iconUri=""
                focusedIconUri=""
                showFocusFootprint="true" />

        <ApiTask id="authTask" />
    </children>
</component>
